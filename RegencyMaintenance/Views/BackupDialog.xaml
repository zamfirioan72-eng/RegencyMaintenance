<ContentDialog
    x:Class="RegencyMaintenance.Views.BackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="💾 GESTIONE BACKUP"
    CloseButtonText="CHIUDI"
    DefaultButton="Close"
    MinWidth="800">

    <Grid MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel>
                    <TextBlock Text="Totale Backup" FontSize="11" Foreground="#607D8B"/>
                    <TextBlock x:Name="TotalBackupsText" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Dimensione Totale" FontSize="11" Foreground="#607D8B"/>
                    <TextBlock x:Name="TotalSizeText" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Più Recente" FontSize="11" Foreground="#607D8B"/>
                    <TextBlock x:Name="NewestText" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Più Vecchio" FontSize="11" Foreground="#607D8B"/>
                    <TextBlock x:Name="OldestText" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Backup List -->
        <ListView x:Name="BackupList" Grid.Row="1"
                  SelectionMode="Single">
            <ListView.Header>
                <Grid Background="#BBDEFB" Padding="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nome File / Percorso" FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="Data" FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Dimensione" FontWeight="Bold" Grid.Column="2"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Filename}" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Date}" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SizeMB}" Grid.Column="2" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Primary Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,4">
            <Button Content="💾 CREA NUOVO BACKUP"
                    Background="#009688" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="CreateBackup_Click"/>
            <Button Content="♻️ RIPRISTINA BACKUP"
                    Background="#FF9800" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="RestoreBackup_Click"/>
            <Button Content="🗑️ ELIMINA BACKUP"
                    Background="#F44336" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="DeleteBackup_Click"/>
        </StackPanel>

        <!-- Secondary Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,0">
            <Button Content="📄 ESPORTA LISTA BACKUP"
                    Background="#607D8B" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="ExportList_Click"/>
            <Button Content="🔄 AGGIORNA"
                    Background="#455A64" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="Refresh_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
