<ContentDialog
    x:Class="RegencyMaintenance.Views.AllInterventionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="📋 TUTTI GLI INTERVENTI"
    CloseButtonText="CHIUDI"
    DefaultButton="Close"
    MinWidth="900">

    <Grid MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary -->
        <TextBlock x:Name="SummaryText" Grid.Row="0"
                   Margin="0,0,0,8" FontSize="13"
                   Foreground="#455A64"/>

        <!-- Table -->
        <ListView x:Name="InterventionsList" Grid.Row="1"
                  SelectionMode="None">
            <ListView.Header>
                <Grid Background="#BBDEFB" Padding="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Data" FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="Ora" FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Stanza" FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Categoria" FontWeight="Bold" Grid.Column="3"/>
                    <TextBlock Text="Note" FontWeight="Bold" Grid.Column="4"/>
                    <TextBlock Text="Operatore" FontWeight="Bold" Grid.Column="5"/>
                    <TextBlock Text="Elimina" FontWeight="Bold" Grid.Column="6"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayDate}" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayTime}" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Room}" Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Category}" Grid.Column="3" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" Grid.Column="4" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Operator}" Grid.Column="5" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="🗑️"
                                Grid.Column="6"
                                Background="#F44336"
                                Foreground="White"
                                Padding="8,4" CornerRadius="4"
                                FontSize="12"
                                Tag="{Binding}"
                                Click="DeleteButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="📄 ESPORTA IN TXT"
                    Background="#2196F3" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="ExportTxt_Click"/>
            <Button Content="💾 CREA BACKUP"
                    Background="#009688" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="CreateBackup_Click"/>
            <Button Content="🔄 AGGIORNA"
                    Background="#607D8B" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="Refresh_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
