<ContentDialog
    x:Class="RegencyMaintenance.Views.ReportPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="📊 ANTEPRIMA REPORT"
    CloseButtonText="CHIUDI"
    DefaultButton="Close"
    MinWidth="800">

    <Grid MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <TextBox x:Name="ReportTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="13"
                     Padding="12"
                     Background="#FAFAFA"
                     MinHeight="400"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="📂 APRI FILE"
                    Background="#2196F3" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="OpenFile_Click"/>
            <Button Content="📋 COPIA TESTO"
                    Background="#4CAF50" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="CopyText_Click"/>
            <Button Content="💾 CREA BACKUP"
                    Background="#009688" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="CreateBackup_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
