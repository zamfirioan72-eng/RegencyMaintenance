<ContentDialog
    x:Class="RegencyMaintenance.Views.PeriodFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="👁️ INTERVENTI PER PERIODO"
    CloseButtonText="CHIUDI"
    DefaultButton="Close"
    MinWidth="900">

    <Grid MinHeight="550">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Date Filters -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Da:" FontWeight="SemiBold" FontSize="13"/>
                        <DatePicker x:Name="FromDatePicker"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="A:" FontWeight="SemiBold" FontSize="13"/>
                        <DatePicker x:Name="ToDatePicker"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stanza/Categoria:" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox x:Name="RoomFilterCombo" MinWidth="160" PlaceholderText="Tutte"/>
                    </StackPanel>
                    <Button Content="🔍 FILTRA"
                            Background="#2196F3" Foreground="White"
                            FontWeight="SemiBold" Padding="14,10" CornerRadius="6"
                            VerticalAlignment="Bottom"
                            Click="Filter_Click"/>
                </StackPanel>

                <!-- Quick Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="📅 OGGI" Background="#4CAF50" Foreground="White"
                            Padding="10,6" CornerRadius="4" FontSize="12"
                            Click="Today_Click"/>
                    <Button Content="📅 ULTIMI 7 GIORNI" Background="#2196F3" Foreground="White"
                            Padding="10,6" CornerRadius="4" FontSize="12"
                            Click="Last7Days_Click"/>
                    <Button Content="📅 ULTIMI 30 GIORNI" Background="#FF9800" Foreground="White"
                            Padding="10,6" CornerRadius="4" FontSize="12"
                            Click="Last30Days_Click"/>
                    <Button Content="📅 TUTTI" Background="#9C27B0" Foreground="White"
                            Padding="10,6" CornerRadius="4" FontSize="12"
                            Click="ShowAll_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <TextBlock x:Name="ResultSummary" Grid.Row="1"
                   Margin="0,0,0,8" FontSize="13" Foreground="#455A64"/>

        <!-- Results Table -->
        <ListView x:Name="ResultsList" Grid.Row="2" SelectionMode="None">
            <ListView.Header>
                <Grid Background="#BBDEFB" Padding="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Data" FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="Ora" FontWeight="Bold" Grid.Column="1"/>
                    <TextBlock Text="Stanza" FontWeight="Bold" Grid.Column="2"/>
                    <TextBlock Text="Categoria" FontWeight="Bold" Grid.Column="3"/>
                    <TextBlock Text="Note" FontWeight="Bold" Grid.Column="4"/>
                    <TextBlock Text="Operatore" FontWeight="Bold" Grid.Column="5"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayDate}" Grid.Column="0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayTime}" Grid.Column="1" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Room}" Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Category}" Grid.Column="3" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" Grid.Column="4" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Operator}" Grid.Column="5" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Export Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="📄 ESPORTA IN TXT"
                    Background="#2196F3" Foreground="White"
                    FontWeight="SemiBold" Padding="12,8" CornerRadius="6"
                    Click="ExportTxt_Click"/>
        </StackPanel>
    </Grid>
</ContentDialog>
