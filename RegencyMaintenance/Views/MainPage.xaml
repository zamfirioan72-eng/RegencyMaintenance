<Page
    x:Class="RegencyMaintenance.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#E3F2FD">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#BBDEFB"
                BorderBrush="#1976D2"
                BorderThickness="0,0,0,2"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="OperatorText"
                               FontSize="14"
                               Foreground="#1565C0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="🏨 THE REGENCY MAINTENANCE"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#0D47A1"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DateTimeText"
                               FontSize="13"
                               Foreground="#1565C0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Sistema Gestione Manutenzione"
                               FontSize="12" Foreground="#5C7EB8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Room Grid -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="12">
                <!-- Floor 1 -->
                <TextBlock Text="Piano 1" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor1Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Floor 2 -->
                <TextBlock Text="Piano 2" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor2Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Floor 3 -->
                <TextBlock Text="Piano 3" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor3Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Floor 4 -->
                <TextBlock Text="Piano 4" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor4Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Floor 5 -->
                <TextBlock Text="Piano 5" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor5Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Floor 6 -->
                <TextBlock Text="Piano 6" FontSize="13" FontWeight="SemiBold"
                           Foreground="#455A64" Margin="0,4,0,2"/>
                <ItemsControl x:Name="Floor6Panel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Common Space -->
                <Button x:Name="CommonSpaceButton"
                        Content="🏢 SPAZIO COMUNE"
                        Background="#4DB6AC"
                        Foreground="White"
                        FontSize="15" FontWeight="Bold"
                        Padding="20,14"
                        Margin="0,8,0,0"
                        CornerRadius="8"
                        Click="RoomButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Command Bar -->
        <Border Grid.Row="2"
                Background="#ECEFF1"
                BorderBrush="#B0BEC5"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="📊 GENERA REPORT GIORNALIERO"
                            Background="#2196F3" Foreground="White"
                            FontWeight="SemiBold" Padding="12,10"
                            CornerRadius="6"
                            Click="GenerateReport_Click"/>
                    <Button Content="👁️ INTERVENTI PER PERIODO"
                            Background="#FF9800" Foreground="White"
                            FontWeight="SemiBold" Padding="12,10"
                            CornerRadius="6"
                            Click="PeriodFilter_Click"/>
                    <Button Content="👤 CAMBIA OPERATORE"
                            Background="#9C27B0" Foreground="White"
                            FontWeight="SemiBold" Padding="12,10"
                            CornerRadius="6"
                            Click="ChangeOperator_Click"/>
                    <Button Content="📋 TUTTI GLI INTERVENTI"
                            Background="#5C6BC0" Foreground="White"
                            FontWeight="SemiBold" Padding="12,10"
                            CornerRadius="6"
                            Click="AllInterventions_Click"/>
                    <Button Content="💾 GESTIONE BACKUP"
                            Background="#009688" Foreground="White"
                            FontWeight="SemiBold" Padding="12,10"
                            CornerRadius="6"
                            Click="BackupManagement_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
